{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "db_init": "npx tsx ./scripts/dbSetup.ts",
    "db_push": "npx drizzle-kit push",
    "db_generate": "npx drizzle-kit generate",
    "db_migrate": "npx drizzle-kit migrate",
    "db_delete": "npx tsx ./scripts/dbSetup.ts DELETE",
    "db_nuke": "npx tsx ./scripts/dbSetup.ts DELETE && rm -rf src/database/migrations"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "better-sqlite3": "^11.10.0",
    "bootstrap": "^5.3.7",
    "dotenv-expand": "^12.0.2",
    "drizzle-orm": "^0.41.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^3.2.4",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.30.6",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "3.5.3",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.4"
  },
  "main": "dist-electron/main.js"
}
